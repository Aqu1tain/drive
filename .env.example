# ── Docker Compose (docker compose up) ─────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Two distinct origins: the app, and the isolated content (HTML pages).
# In production, put user content on a separate registrable domain (e.g. drive-usercontent.net).
APP_URL=http://localhost:3000
USERCONTENT_URL=http://127.0.0.1:3000
APP_NAME=Drive
# Optional: required to create the owner account on first launch
SETUP_TOKEN=
# true when behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Leave the default to catch emails in Mailpit (http://localhost:8125), or point to a real SMTP server
SMTP_URL=smtp://mailpit:1025
SMTP_FROM=Drive <drive@localhost>
ACTIVITY_RETENTION_DAYS=365
# hash | none
ACTIVITY_IP_MODE=hash

# ── Local development (pnpm dev, services from docker compose up db minio mailpit) ──
NUXT_AUTH_SECRET=
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_USERCONTENT_URL=http://127.0.0.1:3000
NUXT_PUBLIC_APP_NAME=Drive
NUXT_DATABASE_URL=postgres://drive:drive@localhost:5442/drive
# local | s3
NUXT_STORAGE_DRIVER=local
NUXT_STORAGE_LOCAL_DIR=./storage-data
NUXT_STORAGE_S3_ENDPOINT=http://localhost:9100
NUXT_STORAGE_S3_REGION=us-east-1
NUXT_STORAGE_S3_BUCKET=drive
NUXT_STORAGE_S3_ACCESS_KEY_ID=drive
NUXT_STORAGE_S3_SECRET_ACCESS_KEY=drive-secret
NUXT_STORAGE_S3_FORCE_PATH_STYLE=true
NUXT_SMTP_URL=smtp://localhost:1125
NUXT_SMTP_FROM=Drive <drive@localhost>
NUXT_UPLOAD_MAX_BYTES=5368709120
NUXT_STORAGE_QUOTA_BYTES=107374182400
NUXT_ACTIVITY_RETENTION_DAYS=365
NUXT_ACTIVITY_IP_MODE=hash
