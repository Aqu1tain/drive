# ── Production (compose.yaml) ─────────────────────────────────────
# ./install.sh writes these for you. Generate secrets with: openssl rand -base64 32
APP_NAME=Drive
# en | fr: language of the interface for everyone who has not picked one, and of emails and shared pages
DEFAULT_LOCALE=en
APP_URL=https://drive.example.com
USERCONTENT_URL=https://files.example.com
# With COMPOSE_PROFILES=https, Caddy serves both domains with automatic HTTPS
APP_DOMAIN=drive.example.com
CONTENT_DOMAIN=files.example.com
COMPOSE_PROFILES=https
TRUST_PROXY=true
# Expose the app directly (no Caddy): APP_BIND=0.0.0.0, APP_PORT=3000, CONTENT_PORT=3001
APP_BIND=127.0.0.1
AUTH_SECRET=
SETUP_TOKEN=
POSTGRES_PASSWORD=
S3_SECRET_ACCESS_KEY=
# Optional: send invitations and sign-in codes by email
SMTP_URL=
SMTP_FROM=Drive <drive@example.com>
ACTIVITY_RETENTION_DAYS=365
# hash | none
ACTIVITY_IP_MODE=hash

# ── Local development (pnpm dev + docker compose -f compose.dev.yaml up -d) ──
NUXT_AUTH_SECRET=
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_USERCONTENT_URL=http://127.0.0.1:3000
NUXT_PUBLIC_APP_NAME=Drive
NUXT_DATABASE_URL=postgres://drive:drive@localhost:5442/drive
# local | s3
NUXT_STORAGE_DRIVER=local
NUXT_STORAGE_LOCAL_DIR=./storage-data
NUXT_STORAGE_S3_ENDPOINT=http://localhost:9100
NUXT_STORAGE_S3_REGION=us-east-1
NUXT_STORAGE_S3_BUCKET=drive
NUXT_STORAGE_S3_ACCESS_KEY_ID=drive
NUXT_STORAGE_S3_SECRET_ACCESS_KEY=drive-secret
NUXT_STORAGE_S3_FORCE_PATH_STYLE=true
NUXT_SMTP_URL=smtp://localhost:1125
NUXT_SMTP_FROM=Drive <drive@localhost>
